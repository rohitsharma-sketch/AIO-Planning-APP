# Secrets — never commit real credentials
.env
!.env.example

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Node / frontend builds
node_modules/
dist/

# OS/editor cruft
.DS_Store
Thumbs.db

# Superpowers scratch workspace (git-ignored by convention)
.superpowers/

# Claude Code native worktrees (nested working trees — never track these;
# project-level .claude/launch.json configs elsewhere in the tree are
# unaffected, this only anchors to the repo root)
/.claude/worktrees/

# Generated/computed engine outputs — regenerated by running the app,
# not source. (final_dept_plan.json alone exceeded GitHub's 100MB limit.)
SalesPlan/backend/*.json
Tentative AOP Forecaster/sessions/

# Durable last-known-good data-lake scan cache — regenerated on every
# successful scan; also carries real store/sales data, never source.
RS Planning Platform/backend/calendar_engine/Local DB/scan_cache/

# Per-job payload/progress/result files for the reindex subprocess worker —
# transient, carries real sales/store data, never source.
RS Planning Platform/backend/calendar_engine/Local DB/reindex_jobs/
RS Planning Platform/backend/calendar_engine/Local DB/link_scan_jobs/

# Rolling reindex-duration samples used to estimate ETA (see
# _record_reindex_timing in scans.py) — regenerated as runs complete, never source.
RS Planning Platform/backend/calendar_engine/Local DB/reindex_timing_stats.json

# Auto-sync scheduled task's run log — regenerated daily, never source.
Tentative AOP Forecaster/auto_sync.log

# Suite theme choice picked on Landing - local state, not source
RS Planning Platform/backend/data/suite_theme.json

# Listing/Delisting (additional app): source workbooks and generated data - business data, never in git
data/listing/
Listing Delisting/app/*.json
Landing/keep_alive.log
RS Planning Platform/backend/data/user_rights.json
RS Planning Platform/backend/data/sign_in_as.log

# logs / backups / generated outputs (cleanup 2026-10-05)
*.bak
SalesPlan/watchdog.log
Tentative AOP Forecaster/backend.log
Tentative AOP Forecaster/output/
Tentative AOP Forecaster/diff_archive/

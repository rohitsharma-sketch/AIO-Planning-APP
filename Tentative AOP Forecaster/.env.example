# Local Postgres — dedicated database on the shared local instance (127.0.0.1:5432)
DATABASE_URL=postgresql+psycopg://rs_planning_app:CHANGE_ME@127.0.0.1:5432/rs_planning

# Session signing key for 8010 + 8000 (cookies, remember-me, reset links). REQUIRED when APP_ENV=production:
# 32+ random characters, never the dev default. Set it as a Windows user environment variable, not in this file.
SESSION_SECRET=
# "production" on the live server (the apps then refuse to start without a strong SESSION_SECRET); empty = development
APP_ENV=

@echo off
title CityKart Sales Plan

:: Kill any stale process on port 8002 so restart is always clean
for /f "tokens=5" %%a in ('netstat -aon ^| findstr ":8002 "') do (
    taskkill /PID %%a /F >nul 2>&1
)

cd /d "%~dp0backend"
set PATH=C:\Users\A9820\AppData\Local\Python\pythoncore-3.14-64\Scripts;C:\Users\A9820\AppData\Local\Python\pythoncore-3.14-64;C:\Windows\System32;C:\Windows

echo.
echo  ================================================
echo   CityKart Sales Plan
echo   Starts: API server + MRP file-watcher
echo   URL   : http://localhost:8002
echo  ================================================
echo.

timeout /t 2 /nobreak >nul
start "" "http://localhost:8002"

uvicorn main:app --host 0.0.0.0 --port 8002
